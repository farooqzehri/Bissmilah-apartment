# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bismillah_db?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary Image Storage Credentials (from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin authentication: configure a private passcode (at least 8 characters)
ADMIN_PIN=
ADMIN_USERNAME=admin

# Generate a random secret with at least 32 characters; never reuse this example file's values
JWT_SECRET=

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API (injected automatically in AI Studio)
GEMINI_API_KEY=
APP_URL=
